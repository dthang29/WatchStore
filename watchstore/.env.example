# Docker Compose đọc file .env cùng thư mục. Copy file này thành .env rồi điền giá trị.
MYSQL_USER=watchstore
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3307

# Base64, tối thiểu 256 bit: openssl rand -base64 48
JWT_SECRET=

FRONTEND_URL=http://localhost:5173

# Admin được tạo lúc backend khởi động nếu email chưa tồn tại
ADMIN_EMAIL=admin@watchshop.vn
ADMIN_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
